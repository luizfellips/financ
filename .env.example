# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://financ:financ@localhost:5432/financ?schema=public

# Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional: seed demo user password override
SEED_USER_EMAIL=demo@financ.app
SEED_USER_PASSWORD=Demo@123456
SEED_USER_NAME=Usuário Demo
